{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIScreenshotAssi",
  "version": "0.1.0",
  "identifier": "com.aiagent.mac",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "AIScreenshotAssi",
        "width": 420,
        "height": 68,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "hiddenTitle": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "./Info.plist",
      "entitlements": "./entitlements.plist",
      "minimumSystemVersion": "13.0",
      "frameworks": [],
      "exceptionDomain": ""
    }
  }
}
